# =============================================================================
# Environment Configuration
# Copy this file to .env and update values for your environment
# =============================================================================

# Application Settings
APP_NAME=table-extraction-system
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/table_extraction
DATABASE_POOL_SIZE=10

# Redis (for task queue and caching)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage
STORAGE_TYPE=local  # local, s3, minio
STORAGE_PATH=./data/uploads
S3_BUCKET=table-extraction-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
MINIO_ENDPOINT=localhost:9000

# Model Settings
MODEL_DEVICE=cuda  # cuda, cpu
TABLE_DETECTION_MODEL=yolov8
TABLE_DETECTION_WEIGHTS=./models/weights/table_detector.pt
STRUCTURE_MODEL=tableformer
STRUCTURE_WEIGHTS=./models/weights/structure_model.pt
OCR_ENGINE=easyocr  # easyocr, tesseract, paddle
OCR_LANGUAGES=ko,en

# Processing Settings
MAX_IMAGE_SIZE=4096
BATCH_SIZE=4
NUM_WORKERS=4
CONFIDENCE_THRESHOLD=0.5

# Monitoring
PROMETHEUS_PORT=9090
ENABLE_SENTRY=false
SENTRY_DSN=

# Security
SECRET_KEY=your-super-secret-key-change-in-production
API_KEY_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
